# nginx vhost for stats.opennhp.org: the public, read-only daily stats
# site for the nhp-server XDP ingress filter.
#
# Shares the relay host and the single relay.opennhp.org Let's Encrypt
# cert (SAN expanded by bootstrap-tls.sh to cover stats.opennhp.org).
# Serves a static directory written by `endpoints/xdplog-report site`
# under ${STATS_WEB_ROOT}.
#
# Two properties this file has to preserve, and why they cost what they cost:
#
#   1. Nothing sensitive is reachable. The raw log cache (unmasked source
#      IPs) and the incremental-build state.json (absolute paths of that
#      cache) live OUTSIDE the root below, and /state.json is refused a
#      second time here in case a future -out change puts it back inside.
#   2. nginx can actually read the root. /home/ec2-user is mode 0700 on
#      AL2023 and the workers run as nginx, so a root under $HOME returns
#      403 for every request. The site therefore lives under /var/www, which
#      is world-traversable, and the raw cache stays in $HOME where the
#      permissions are exactly right (0600 raw files, 0700 directories).

# HTTP -> HTTPS redirect. The site is informational but the source IPs
# (truncated server-side via xdplog-report's -mask-ip default) are still
# useful to a passive observer on a coffee-shop wifi, and the operator
# identity is the relay host: don't let a downgrade attack sit on port 80.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_STATS};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN_STATS};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_RELAY}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_RELAY}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    root  ${STATS_WEB_ROOT};
    index index.html;

    # Hardening: the site loads no third-party resources and only one
    # script of its own — countup.js, the homepage counter animation written
    # by `xdplog-report site` into the web root — hence script-src 'self'
    # rather than a CDN host. The only inline style attribute is the bar
    # width the renderer emits (which is a numeric interpolation).
    # default-src 'none' still blocks frames and any future XHR.
    # style-src 'unsafe-inline' keeps the existing inline <style> block
    # working without a nonce rewrite.
    #
    # NOTE ON add_header INHERITANCE: nginx only inherits add_header from an
    # enclosing level when the nested level declares none of its own. Any
    # location that adds a header (Cache-Control below) therefore has to
    # repeat these, or the homepage and index.json ship with no CSP, no
    # HSTS and no nosniff. That is why they are repeated rather than
    # hoisted, and why a new location must copy them.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Hide directory listings. The site is a flat tree; missing files
    # should 404 cleanly without exposing the layout.
    autoindex off;

    # Defense in depth: state.json holds absolute paths of the raw cache.
    # The deploy keeps it outside the root (-state), so this should never
    # match, but a stale file from an older layout must not become public.
    location = /state.json {
        return 404;
    }

    # Per-day detail pages.
    location /d/ {
        limit_except GET HEAD { deny all; }
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri $uri/ =404;
    }

    # index.json: machine-readable summary list. Cache-control is short so
    # a fresh deploy's data is visible within an hour without us needing
    # to bust caches by hand. Security headers are repeated here because
    # nginx drops the server-level ones in any block that sets its own.
    location = /index.json {
        limit_except GET HEAD { deny all; }
        add_header Cache-Control "public, max-age=300" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # index.html: same as above. The browser hits it first.
    location = / {
        limit_except GET HEAD { deny all; }
        add_header Cache-Control "public, max-age=300" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files /index.html =404;
    }

    location / {
        limit_except GET HEAD { deny all; }
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri $uri/ =404;
    }
}