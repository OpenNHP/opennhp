FROM opennhp-base:latest  AS builder

# The base image may ship an older Go than go.mod declares (the worktree's
# go.mod requires go 1.26; a stale opennhp-base:latest still has 1.25.6 with
# GOTOOLCHAIN pinned to 1.25.6). Override to "auto" so Go fetches the exact
# toolchain go.mod asks for instead of hard-failing. If you rebuild the base
# image from the current Dockerfile.base (Go 1.26.5) this line is a no-op.
ENV GOTOOLCHAIN=auto

WORKDIR /nhp-server

COPY . .

RUN echo "Building for architecture: ${TARGETARCH}"

RUN cd /nhp-server &&  make init serverd plugins

FROM ubuntu:22.04  AS runtime

ARG APT_MIRROR=
ENV DEBIAN_FRONTEND=noninteractive

# Switch APT mirror if specified
RUN if [ -n "$APT_MIRROR" ]; then \
    sed -i "s|ports.ubuntu.com|${APT_MIRROR}|g" /etc/apt/sources.list && \
    sed -i "s|archive.ubuntu.com|${APT_MIRROR}|g" /etc/apt/sources.list && \
    sed -i "s|security.ubuntu.com|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi

RUN apt-get update && \
    apt-get install -y  wget \
    ca-certificates \
    nginx \
    iptables \
    tcpdump \
    ipset \
    git \
    curl \
    telnet \
    vim \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /nhp-server/release/nhp-server /nhp-server

ENTRYPOINT ["/bin/sh", "-c"]
CMD ["nginx & /nhp-server/nhp-serverd run"]