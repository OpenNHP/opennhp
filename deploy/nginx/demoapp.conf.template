# nginx vhost for the integrated demo app (demo.opennhp.org).
#
# Shares the relay host and the single relay.opennhp.org Let's Encrypt
# cert (SAN expanded by bootstrap-tls.sh to cover demo.opennhp.org).
# Proxies to the demoapp Gin backend, which serves the embedded SPA on
# :8081 and terminates no TLS itself.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN_DEMO};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_RELAY}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_RELAY}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # Replace, do not append: the demoapp trusts X-Real-IP for
        # per-user rate limiting / audit; $proxy_add_x_forwarded_for
        # would let a client prepend a spoofed entry.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
